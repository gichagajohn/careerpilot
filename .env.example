# ============================================================
# CareerPilot AI — environment template
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ============================================================

# ── Core ──────────────────────────────────────────────────────
APP_NAME=CareerPilot AI
DEBUG=true
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_generate_a_random_64_char_string
# Generate with: python scripts/gen_key.py  (Fernet key for PII encryption)
ENCRYPTION_KEY=

# ── Database ──────────────────────────────────────────────────
# Local development (SQLite, zero setup):
DATABASE_URL=sqlite:///./data/careerpilot.db
# Cloud Postgres (Neon/Supabase) — uncomment when deploying:
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname?sslmode=require
# AUTO_CREATE_TABLES=true lets the app create tables on startup (dev only).
# In production set it false and use Alembic migrations.
AUTO_CREATE_TABLES=true

# ── Auth ──────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

# ── CORS (dashboard origin) ───────────────────────────────────
CORS_ORIGINS=["http://localhost:3000"]

# ── Timezone ──────────────────────────────────────────────────
TIMEZONE=Africa/Nairobi

# ── Uploads ───────────────────────────────────────────────────
MAX_UPLOAD_MB=20

# ── LLM provider (used from Phase 2 onwards) ──────────────────
# free-first: gemini (AI Studio free tier) -> groq fallback -> ollama local
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ── Discovery sources (Phase 2: JobScout) ─────────────────────
# Adzuna jobs API (free tier ~1,000 calls/month, covers adzuna.co.ke)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRIES=["ke"]
# Web search APIs (each has a free tier — at least one is recommended)
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
SERPER_KEY=
TAVILY_KEY=
# Scheduler: run discovery jobs at these hours (local timezone), 3×/day default
ENABLE_SCHEDULER=true
JOBS_SEARCH_HOURS=0,8,16
# Scholarship discovery (2×/day default, spec §15)
SCHOLARSHIP_SEARCH_HOURS=7,19
# Relevance pre-filters: skip out-of-scope items (set false to keep everything)
JOBS_RELEVANCE_FILTER=true
SCHOLARSHIP_RELEVANCE_FILTER=true

# ── Notifications (used from Phase 5 onwards) ─────────────────
# Email via Gmail SMTP app password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
# Telegram bot (BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
